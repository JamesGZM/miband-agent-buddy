{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MiBand Agent Buddy",
  "version": "0.5.0",
  "identifier": "io.github.jamesgzm.miband-agent-buddy",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MiBand Agent Buddy",
        "width": 820,
        "height": 660,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
