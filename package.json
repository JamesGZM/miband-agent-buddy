{
  "name": "miband-agent-buddy",
  "version": "0.7.10",
  "private": true,
  "description": "Turn Xiaomi Smart Band 9 into a desktop display for AI activity and system resources, with macOS and Windows apps",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tests/runtime/*.test.mjs tests/band/*.test.mjs tests/contracts/*.test.mjs tests/architecture/*.test.mjs",
    "build": "python3 scripts/build.py",
    "build:desktop": "python3 scripts/build_desktop.py",
    "bootstrap": "python3 native/transport/bootstrap.py",
    "hooks:install": "node services/runtime/bin/buddy-cli.mjs guide",
    "pretest": "python3 scripts/prepare_shared.py",
    "check:architecture": "node scripts/check_architecture.mjs"
  },
  "license": "AGPL-3.0-only"
}
