     #[tokio::test]
+    async fn ack_sequence_wrap_preserves_unconsumed_mass_acknowledgements() {
+        let (mut sar, _sent) = new_controller("test_mass_ack_wrap", SarLinkParams::SPP);
+        sar.on_l1_packet(&start_rsp());
+        let mut previous = Vec::new();
+        // MASS queues a new batch before consuming ACKs from the previous one.
+        for batch in 0..80 {
+            let current = sar.enqueue_batch((0..16).map(|_| vec![L2Channel::Mass as u8, 1]));
+            for seq in previous {
+                assert!(sar.is_acked(seq), "batch {batch} lost an unconsumed ACK for {seq}");
+                sar.mark_ack_consumed(seq);
+            }
+            sar.on_l1_packet(&L1Packet::new(L1DataType::Ack, false, *current.last().unwrap(), vec![]));
+            previous = current;
+            tokio::task::yield_now().await;
+        }
+        for seq in previous {
+            assert!(sar.is_acked(seq));
+        }
+    }
+
+    #[tokio::test]
+    async fn ack_sequence_reuse_invalidates_only_the_allocated_slot() {
+        let (mut sar, _sent) = new_controller("test_ack_slot_reuse", SarLinkParams::SPP);
+        sar.tx_next_seq = 255;
+        sar.acked.extend([7, 255]);
+        assert_eq!(sar.alloc_seq(), 255);
+        assert!(!sar.is_acked(255), "a reused sequence must wait for its own ACK");
+        assert!(sar.is_acked(7), "another pending consumer still owns this ACK");
+        sar.acked.insert(0);
+        assert_eq!(sar.alloc_seq(), 0);
+        assert!(!sar.is_acked(0));
+        assert!(sar.is_acked(7));
+    }
