<template>
  <stack class="page" onclick="togglePage" onlongpress="exitApp">
    <stack class="page" show="{{ pageIndex === 0 }}">
      <image class="layer" src="/common/capsule/face-track.png" />
      <image class="layer" src="{{ ringSource }}" style="opacity: {{ ringOpacity }};" />
      <image class="layer" src="{{ loadingSource }}" style="opacity: {{ loadingOpacity }};" />
      <image class="layer" src="{{ symbolSource }}" style="left: {{ symbolLeft }}px;" />
    </stack>
    <stack class="page" show="{{ pageIndex === 1 }}">
      <image class="layer" src="/common/capsule/resource-tracks.png" />
      <image class="layer" src="{{ diskRing }}" />
      <image class="layer" src="{{ memoryRing }}" />
      <image class="layer" src="{{ cpuRing }}" />
      <div class="numbers">
        <div class="column"><text class="label disk">DISK</text><text class="value">{{ diskText }}</text><text class="detail">{{ diskDetail }} GB</text></div>
        <div class="column"><text class="label memory">MEM</text><text class="value">{{ memoryText }}</text><text class="detail">{{ memoryDetail }} GiB</text></div>
        <div class="column"><text class="label cpu">CPU</text><text class="value">{{ cpuText }}</text><text class="detail">TOTAL LOAD</text></div>
      </div>
    </stack>
  </stack>
</template>
<script>
import brightness from '@system.brightness';
import interconnect from '@system.interconnect';
import application from '@system.app';
import storage from '@system.storage';
var protocol = require('../../common/protocol');
var display = require('../../common/display');
var ui = require('../../common/native-ui');
var keepScreen = require('../../common/keep-screen');
var settingsModule=require('../../common/settings');
var settingsController=null, buddyTheme='chatgpt', keepWanted=true;
var keepController = null;
var channel = null, timer = null, exitTimer = null, lastMessage = null;
var receivedAt = 0, visible = false, lastTapAt = -1000;
var activeMode = 'idle', modeAt = 0, exiting = false, metricsStamp = '';
var rings = null, snapMetrics = true, lastRingPaint = 0;
export default {
  private: {
    pageIndex: 0, received: 0, keepResult: 'pending', errorText: '', gestureCount: 0,
    ringSource: '/common/capsule/ring-idle.png', ringOpacity: .32,
    loadingSource: '/common/capsule/blank.png', loadingOpacity: 1,
    symbolSource: '/common/capsule/symbols.png', symbolLeft: 0,
    diskRing: '/common/capsule/disk-000.png', memoryRing: '/common/capsule/memory-000.png', cpuRing: '/common/capsule/cpu-000.png',
    cpuText: '—', memoryText: '—', diskText: '—', memoryDetail: '—', diskDetail: '—', cpuWidth: 0, memoryWidth: 0, diskWidth: 0
  },
  onInit() {
    var self = this;
    keepController=keepScreen.createKeepScreen(function(options){brightness.setKeepScreenOn(options);},Date.now,setTimeout,clearTimeout,function(state,code){self.keepResult=state;if(state==='error')self.errorText='KEEP error '+code;});
    buddyTheme='chatgpt';keepWanted=true;
    settingsController=settingsModule.createSettings(storage,function(value){buddyTheme=value.buddyTheme;var changed=keepWanted!==value.keepScreen;keepWanted=value.keepScreen;if(visible&&changed){if(keepWanted)keepController.show();else keepController.hide();}self.tick();});
    settingsController.load();
    lastMessage=null; receivedAt=0; activeMode='idle'; modeAt=Date.now(); exiting=false; metricsStamp='';
    this.pageIndex=0;lastTapAt=-1000;
    rings={cpu:ui.createRingTransition(),memory:ui.createRingTransition(),disk:ui.createRingTransition()};snapMetrics=true;
    try {
      channel=interconnect.instance();
      channel.onmessage=function(event) {
        var msg;
        try { msg=protocol.acceptMessage(event.data,lastMessage); } catch(error) { self.errorText='Invalid message'; return; }
        if(!msg || exiting)return;
        settingsController.apply(msg);
        lastMessage=msg; receivedAt=Date.now(); self.received+=1;
        if((msg.mode||'idle')!==activeMode){activeMode=msg.mode||'idle';modeAt=receivedAt;}
        self.tick();
        var ack=protocol.makeAck(msg,self.keepResult,self.received);
        ack.appVersion='0.5.0';var settingsAck=settingsController.snapshot(msg);for(var settingKey in settingsAck)ack[settingKey]=settingsAck[settingKey];ack.keepDiagnostics=keepController.snapshot();ack.page=self.pageIndex;ack.memory=!!msg.memory;ack.disk=!!msg.disk;
        ack.character=buddyTheme==='claude'?'claude':'codex';ack.mode=activeMode;ack.gestures=self.gestureCount;ack.exitReady=true;
        if(msg.command==='exit')exitTimer=setTimeout(function(){self.exitApp();},500);
        channel.send({data:ack,success:function(){self.errorText='';if(msg.command==='exit')self.exitApp();},fail:function(data,code){self.errorText='ACK error '+code;if(msg.command==='exit')self.exitApp();}});
      };
      channel.onerror=function(event){self.errorText='LINK error '+event.code;};
    }catch(error){this.errorText='Interconnect unavailable';}
  },
  onShow() {
    visible=true;snapMetrics=true;metricsStamp='';if(keepController&&keepWanted)keepController.show();this.tick();
  },
  onHide(){this.releaseKeep();},
  onBackPress(){this.releaseKeep();return false;},
  onDestroy(){this.releaseKeep();if(settingsController)settingsController.close();if(channel){channel.onmessage=null;channel.onerror=null;}channel=null;},
  exitApp(){
    if(exiting)return;
    exiting=true;this.releaseKeep();
    try{application.terminate();}catch(error){exiting=false;this.errorText='Exit unavailable';}
  },
  togglePage(){
    var now=Date.now();
    if(!visible||exiting||(now>=lastTapAt&&now-lastTapAt<250))return;
    lastTapAt=now;
    this.act(this.pageIndex===0?'monitor':'pet');
  },
  act(action){
    if(!action||exiting)return;
    this.gestureCount+=1;
    if(action==='exit'){this.exitApp();return;}
    var nextPage=action==='monitor'?1:0;
    if(nextPage!==this.pageIndex){snapMetrics=true;metricsStamp='';}
    this.pageIndex=nextPage;this.tick();
  },
  releaseKeep(){
    visible=false;
    if(timer)clearTimeout(timer);timer=null;
    if(exitTimer)clearTimeout(exitTimer);exitTimer=null;
    if(keepController)keepController.hide();
  },
  tick(){
    if(timer)clearTimeout(timer);timer=null;
    if(!visible||exiting)return;
    var now=Date.now(),stale=!receivedAt||now-receivedAt>=10000||now<receivedAt;
    var delay=200, name;
    if(this.pageIndex===1){
      var forcePaint=snapMetrics;
      var stamp=(lastMessage?lastMessage.session+':'+lastMessage.seq:'none')+':'+stale;
      if(stamp!==metricsStamp){
        metricsStamp=stamp;
        var fields=display.fields(lastMessage,stale);
        for(var key in fields)if(this[key]!==fields[key])this[key]=fields[key];
        for(name in rings){
          // Unknown data clears immediately instead of animating toward a fake zero.
          var missing=fields[name+'Text']==='—';
          ui.retargetRing(rings[name],fields[name+'Width'],now,snapMetrics||missing);
        }
        snapMetrics=false;
      }
      var moving=false, paint=forcePaint||now-lastRingPaint>=80||now<lastRingPaint;
      for(name in rings){
        var src=ui.ringSource(name,ui.ringValue(rings[name],now));
        if((paint||stale)&&this[name+'Ring']!==src)this[name+'Ring']=src;
        if(!paint&&!stale&&this[name+'Ring']!==src)moving=true;
        if(ui.ringMoving(rings[name],now))moving=true;
      }
      if(paint)lastRingPaint=now;
      // Static resource pages only wake for incoming data or the stale deadline.
      delay=moving?Math.max(1,80-(now-lastRingPaint)):(!stale?Math.max(1,10000-(now-receivedAt)):0);
    }else{
      var mode=stale&&lastMessage?'offline':activeMode;
      if(mode==='complete'&&now-modeAt>=4000)mode='idle';
      var motion=ui.motion(mode,Math.max(0,(now-modeAt)/1000),buddyTheme);
      for(name in motion)if(this[name]!==motion[name])this[name]=motion[name];
    }
    if(delay){var self=this;timer=setTimeout(function(){timer=null;self.tick();},delay);}
  }
};
</script>
<style>
.page { width: 192px; height: 490px; background-color: #000000; }
.layer { width: 192px; height: 490px; left: 0px; top: 0px; object-fit: contain; }
.numbers { position: absolute; left: 192px; top: 0px; width: 490px; height: 192px; transform-origin: 0px 0px; transform: rotate(90deg); padding-left: 86px; padding-top: 49px; }
.column { width: 106px; height: 94px; flex-direction: column; align-items: center; }
.label { font-size: 16px; width: 106px; height: 24px; text-align: center; }
.disk { color: #647FFF; }
.memory { color: #A192FF; }
.cpu { color: #78EDFF; }
.value { font-size: 38px; color: #F0F4F0; width: 106px; height: 46px; text-align: center; }
.detail { font-size: 14px; color: #B9C5C0; width: 106px; height: 24px; text-align: center; }
</style>
